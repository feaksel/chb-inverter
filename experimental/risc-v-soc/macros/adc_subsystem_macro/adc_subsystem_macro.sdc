set_clock_uncertainty 0.5 [get_clocks {clk}]
set_clock_latency -source -early -min -rise  -0.434775 [get_ports {clk}] -clock clk 
set_clock_latency -source -early -min -fall  -0.460909 [get_ports {clk}] -clock clk 
set_clock_latency -source -early -max -rise  -0.434775 [get_ports {clk}] -clock clk 
set_clock_latency -source -early -max -fall  -0.460909 [get_ports {clk}] -clock clk 
set_clock_latency -source -late -min -rise  -0.434775 [get_ports {clk}] -clock clk 
set_clock_latency -source -late -min -fall  -0.460909 [get_ports {clk}] -clock clk 
set_clock_latency -source -late -max -rise  -0.434775 [get_ports {clk}] -clock clk 
set_clock_latency -source -late -max -fall  -0.460909 [get_ports {clk}] -clock clk 
